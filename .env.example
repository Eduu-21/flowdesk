# ---------- REQUIRED ----------
# PostgreSQL connection string. Example for a local database named "flowdesk":
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/flowdesk

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---------- OPTIONAL (defaults shown) ----------
# Port the API listens on
PORT=4000

# URL of the React app (used for CORS and links in emails)
CLIENT_URL=http://localhost:5173

# How long a login token lasts
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d

# development | production | test
NODE_ENV=development

# Email via Resend (https://resend.com). Leave EMAIL_API_KEY empty to run in
# development mode: emails are printed to the server console instead of sent.
EMAIL_API_KEY=
EMAIL_FROM=FlowDesk <onboarding@resend.dev>

# Flow Assistant. Leave ANTHROPIC_API_KEY empty to use the built-in
# database-backed assistant (no external API needed).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
